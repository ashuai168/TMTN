{
  "name": "tmtn",
  "version": "0.1.0",
  "description": "本地运行的 BSC Agent 内盘快速买卖终端（Flap / Four / gang.fun），通过币安 Agentic Wallet（baw）下单；默认模拟盘",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "watch:four": "node scripts/watch-four.js",
    "testnet:info": "node scripts/testnet-info.js",
    "live": "MODE=live node server.js",
    "live:8788": "MODE=live LIVE_TRADE=1 AUTO_TRANSFER_FOUR=0 PORT=8788 node server.js",
    "sim:8787": "MODE=sim PORT=8787 node server.js"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "express": "5.1.0",
    "ws": "8.18.3"
  },
  "license": "MIT"
}
